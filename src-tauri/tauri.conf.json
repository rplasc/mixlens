{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixLens",
  "mainBinaryName": "MixLens",
  "version": "0.1.0",
  "identifier": "app.mixlens.desktop",
  "build": {
    "frontendDist": "../ui/dist/mixlens-ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix ui run start",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MixLens",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Music",
    "shortDescription": "Mixing and mastering analysis with an AI assistant",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
